<Page x:Class="project.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:project"
        mc:Ignorable="d">
    <Grid Background="Black">
        <MediaElement x:Name="BackgroundVideo"
                      Source="background/backgroundvideo.mp4"
                      LoadedBehavior="Play"
                      UnloadedBehavior="Stop"
                      IsMuted="True"/>
        <TextBlock x:Name="ClockText"
                   Text="00:00:00"
                   FontSize="60"
                   FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        <Button Content="Open Alarms" 
                Width="89" 
                Height="30" 
                Margin="0,0,71,30"
                Click="openAlarms_clhandler" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Yu Gothic Light" BorderBrush="#FFB50E0E" IsCancel="True"/>
    </Grid>
</Page>
