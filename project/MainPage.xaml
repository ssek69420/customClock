<Page x:Class="project.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:project"
      xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
      mc:Ignorable="d"
      Title="Clock">


    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="BlueViolet" Offset="0"/>
                <GradientStop Color="AliceBlue" Offset="0.55"/>
                <GradientStop Color="DarkBlue" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="420"
                Padding="28"
                CornerRadius="28"
                Background="#22000000"
                BorderBrush="Pink"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="6"
                                  Opacity="0.28"/>
            </Border.Effect>

            <Grid>
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock x:Name="ClockText"
                               Text="00:00:00"
                               FontSize="64"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Label"
                               Text="A"
                               Margin="0,8,0,0"
                               FontSize="15"
                               Foreground="#DCEBFF"
                               HorizontalAlignment="Center"
                               Opacity="0.85"/>
                </StackPanel>

                <Button Click="openAlarms_clhandler"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="{x:Null}"
                        BorderThickness="1"
                        Padding="0"
                        Cursor="Hand">
                    <Border CornerRadius="22"
                            Background="Transparent">
                        <emoji:TextBlock Text="🔔"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>