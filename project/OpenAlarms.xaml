<Page x:Class="project.OpenAlarms"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:project"
      mc:Ignorable="d">

    <Grid>

        <!-- Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="BlueViolet" Offset="0"/>
                <GradientStop Color="AliceBlue" Offset="0.55"/>
                <GradientStop Color="DarkBlue" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <!-- Main Content -->
        <Grid Width="900"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>


            <!-- ========================= -->
            <!-- CREATE ALARM -->
            <!-- ========================= -->

            <Border Grid.Column="0"
                    Padding="28"
                    CornerRadius="28"
                    Background="#22000000"
                    BorderBrush="Pink"
                    BorderThickness="1">

                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="Set Alarm"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>


                    <!-- Time Picker -->
                    <Border Width="350"
        Height="140"
        Background="#22000000"
        BorderBrush="#66FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <!-- HOURS -->
                            <StackPanel Grid.Column="0">

                                <Button Content="▲"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontSize="16"
                    Click="HourUp_Click"/>

                                <Border Height="55"
                    Background="#33111111"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">

                                    <TextBlock x:Name="HourText"
                           Text="06"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                </Border>

                                <Button Content="▼"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontSize="16"
                    Click="HourDown_Click"/>

                            </StackPanel>


                            <!-- FIRST COLON -->
                            <TextBlock Grid.Column="1"
                   Text=":"
                   FontSize="28"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>


                            <!-- MINUTES -->
                            <StackPanel Grid.Column="2">

                                <Button Content="▲"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontSize="16"
                    Click="MinuteUp_Click"/>

                                <Border Height="55"
                    Background="#33111111"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">

                                    <TextBlock x:Name="MinuteText"
                           Text="55"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                </Border>

                                <Button Content="▼"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontSize="16"
                    Click="MinuteDown_Click"/>

                            </StackPanel>


                            <!-- SECOND COLON -->
                            <TextBlock Grid.Column="3"
                   Text=":"
                   FontSize="28"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>



                            <!-- SECONDS -->
                            <StackPanel Grid.Column="4">

                                <Button Content="▲"
                   Height="30"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#CCCCCC"
                   FontSize="16"
                   Click="SecondUp_Click"/>

                                <Border Height="55"
                    Background="#33111111"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4">

                                    <TextBlock x:Name="SecondText"
                           Text="00"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                </Border>

                                <Button Content="▼"
                    Height="30"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontSize="16"
                    Click="SecondDown_Click"/>

                            </StackPanel>

                        </Grid>
                    </Border>


                    <!-- Add Alarm Button -->
                    <Button x:Name="AddAlarmButton"
                    Content="＋  Add Alarm"
                    Width="200"
                    Height="50"
                    Margin="0,20,0,0"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#663C1475"
                    BorderBrush="Pink"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="AddAlarmButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ========================= -->
            <!-- ACTIVE ALARMS -->
            <!-- ========================= -->

            <Border Grid.Column="2"
                    Padding="24"
                    CornerRadius="28"
                    Background="#22000000"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Header -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Active Alarms"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Text="Your currently scheduled alarms"
                                       FontSize="13"
                                       Foreground="#CCFFFFFF"
                                       Margin="0,3,0,0"/>

                        </StackPanel>


                        <!-- Alarm Counter -->
                        <Border Grid.Column="1"
                                Width="55"
                                Height="55"
                                CornerRadius="18"
                                Background="#553C1475"
                                BorderBrush="Pink"
                                BorderThickness="1">

                            <TextBlock x:Name="AlarmCountText"
                                       Text="0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>


                    <!-- Separator -->
                    <Border Grid.Row="1"
                            Height="1"
                            Background="#55FFFFFF"
                            Margin="0,20,0,15"/>


                    <!--
                        Active alarms will be inserted here
                        The button handler dynamically populates the container (not yet stylized though)
                    -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid Grid.Row="2">

                            <TextBlock x:Name="NoAlarmsText"
               Text="No active alarms"
               FontSize="16"
               Foreground="#AAFFFFFF"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

                            <!-- Actual alarm list -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                                <StackPanel x:Name="ActiveAlarmsPanel"/>

                            </ScrollViewer>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>